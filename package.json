{
  "name": "desktop-reactjs-boilerplate",
  "version": "2.0.0",
  "private": true,
  "description": ":electron: (2022) Reactjs 19 with Redux.",
  "main": "public/electron.js",
  "homepage": "./",
  "build": {
    "appId": "<com.desktop-reactjs-boilerplate>"
  },
  "bugs": {
    "url": "https://github.com/kkamara/desktop-reactjs-boilerplate/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://www.github.com/kkamara/desktop-reactjs-boilerplate"
  },
  "license": "MIT",
  "author": "https://www.github.com/kkamara/desktop-reactjs-boilerplate",
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "react-test": "react-scripts test --env=jsdom",
    "react-eject": "react-scripts eject",
    "electron-build": "electron-builder",
    "release": "npm run build && electron-builder --linux --win --mac --x64 --ia32 --publish never",
    "builder:build": "electron-builder --win --x64 --publish never",
    "builder:build:windows": "electron-builder --win --x64 --publish never",
    "build": "npm run react-build && npm run builder:build",
    "start": "concurrently \"cross-env BROWSER=none npm run react-start\" \"wait-on http://localhost:3000 && electron .\""
  },
  "dependencies": {
    "@popperjs/core": "^2.11.6",
    "@reduxjs/toolkit": "^2.8.1",
    "axios": "^1.7.9",
    "bootstrap": "^5.3",
    "jquery": "^3.6.3",
    "moment": "^2.30.1",
    "react": "^19.0.0",
    "react-bootstrap": "^2.7",
    "react-dom": "^19.0.0",
    "react-helmet": "^6.1.0",
    "react-paginate": "^8.3.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.1.5",
    "react-router-dom": "^7.1.5",
    "react-scripts": "^5.0.1",
    "sass": "^1.84.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^8.0.2"
  }
}
